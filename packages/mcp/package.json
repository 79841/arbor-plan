{
  "name": "@arbor-plan/mcp",
  "version": "1.0.0",
  "description": "MCP Server for Arbor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "arbor-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@arbor-plan/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chokidar": "^4.0.3",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
