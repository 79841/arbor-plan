{
  "name": "@arbor-plan/visualizer",
  "version": "1.0.0",
  "description": "Web Visualizer for Arbor",
  "type": "module",
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "tsup --config tsup.server.config.ts",
    "dev": "vite",
    "dev:server": "tsup --config tsup.server.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@arbor-plan/core": "workspace:*",
    "@arbor-plan/mcp": "workspace:*",
    "@xyflow/react": "^12.4.3",
    "chokidar": "^4.0.3",
    "express": "^4.21.2",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
